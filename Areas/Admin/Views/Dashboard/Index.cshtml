@model IEnumerable<FinalTask.Models.Article>
@using FinalTask.DTOs

@{
    ViewData["Title"] = "Platform Control";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categoriesList = ViewBag.CategoriesList as IEnumerable<CategoryDTO> ?? new List<CategoryDTO>();
}

<style>
    .chronicle-admin {
        font-family: 'Georgia', serif;
    }

    .btn-primary {
        display: inline-block;
        background: #1A1A1A;
        color: #FDFBF7;
        font-family: system-ui, -apple-system, sans-serif;
        /* Чистий sans як на головній */
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        padding: 11px 20px;
        border: none;
        cursor: pointer;
        transition: background 0.2s;
        text-decoration: none;
        width: 100%;
        text-align: center;
        border-radius: 0;
    }

        .btn-primary:hover {
            background: rgba(26, 26, 26, 0.8);
            color: #FDFBF7;
        }

    .btn-redact {
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        color: #6B1F1F;
        background: none;
        border: none;
        border-bottom: 1px solid #6B1F1F;
        padding: 2px 0;
        cursor: pointer;
        transition: color 0.15s, border-color 0.15s;
    }

        .btn-redact:hover {
            color: #9b2c2c;
            border-color: #9b2c2c;
        }

    .admin-input {
        width: 100%;
        background: #FCFAF5;
        border: none;
        border-bottom: 1px solid rgba(0,0,0,0.3);
        padding: 7px 0;
        font-family: 'Georgia', serif;
        font-size: 14px;
        color: #1A1A1A;
        outline: none;
        transition: border-color 0.2s;
        border-radius: 0;
    }

        .admin-input:focus {
            border-bottom-color: #1A1A1A;
        }

        .admin-input::placeholder {
            color: rgba(0,0,0,0.3);
            font-style: italic;
        }

    .admin-input-mono {
        font-family: 'Courier New', monospace;
        font-size: 12px;
        letter-spacing: 0.04em;
    }

    .admin-label {
        font-family: system-ui, -apple-system, sans-serif;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(0,0,0,0.4);
        display: block;
        margin-bottom: 5px;
    }
</style>

<div class="chronicle-admin w-full max-w-5xl mx-auto px-6 py-10 bg-[#FDFBF7] text-[#1A1A1A]">

    @* Головний заголовок — копія стилю з головної сторінки *@
    <div class="border-b-2 border-black pb-4 mb-10 text-center md:text-left">
        <h1 class="text-4xl md:text-5xl font-black tracking-tight uppercase" style="font-family: 'Georgia';">
            Platform Control
        </h1>
        <p class="text-[10px] font-sans font-bold uppercase tracking-[0.35em] text-black/40 mt-2">
            System Administration &amp; Intelligence
        </p>
    </div>

    @* Картки статистики *@
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12 font-sans">
        <div class="border border-black/10 p-6 bg-[#FCFAF5] transition-all hover:border-black/30">
            <span class="text-[9px] font-bold uppercase tracking-[0.2em] text-black/40 block mb-2">Total Publications</span>
            <span class="text-4xl font-bold tracking-tight text-black" style="font-family: 'Georgia';">@ViewBag.TotalArticles</span>
        </div>
        <div class="border border-black/10 p-6 bg-[#FCFAF5] transition-all hover:border-black/30">
            <span class="text-[9px] font-bold uppercase tracking-[0.2em] text-black/40 block mb-2">Reader Comments</span>
            <span class="text-4xl font-bold tracking-tight text-black" style="font-family: 'Georgia';">@ViewBag.TotalComments</span>
        </div>
        <div class="border border-black/10 p-6 bg-[#FCFAF5] transition-all hover:border-black/30">
            <span class="text-[9px] font-bold uppercase tracking-[0.2em] text-black/40 block mb-2">Active Columns</span>
            <span class="text-4xl font-bold tracking-tight text-black" style="font-family: 'Georgia';">@ViewBag.TotalCategories</span>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">

        @* Ліва колонка (Форма та Індекс) *@
        <div class="lg:col-span-1 space-y-8">

            @* Створення категорії *@
            <div class="border border-black/10 p-6 bg-[#FCFAF5]">
                <h3 class="text-xl font-bold tracking-tight text-black mb-6" style="font-family: 'Georgia';">
                    Establish New Column
                </h3>

                <form method="post" action="@Url.Action("CreateCategory", "Dashboard", new { area = "Admin" })" class="space-y-5">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="admin-label">Column Name</label>
                        <input type="text" name="Name" required class="admin-input" placeholder="e.g., Politics" />
                    </div>
                    <div>
                        <label class="admin-label">URL Slug</label>
                        <input type="text" name="Slug" required class="admin-input admin-input-mono" placeholder="politics" />
                    </div>
                    <div style="padding-top: 1rem;">
                        <button type="submit" class="btn-primary">
                            Register Column
                        </button>
                    </div>
                </form>
            </div>

            @* Індекс активних категорій *@
            <div class="border border-black/10 p-6 bg-[#FCFAF5]">
                <div class="text-[10px] font-sans font-bold uppercase tracking-[0.2em] text-black/55 mb-4">
                    Active Columns Index
                </div>
                <ul style="list-style:none; padding:0; margin:0;">
                    @foreach (var cat in categoriesList)
                    {
                        <li class="py-2.5 flex justify-between items-center border-b border-black/10 font-sans text-xs">
                            <span class="font-bold text-black/80">@cat.Name</span>
                            <span class="font-mono text-[10px] text-black/40">/@cat.Slug</span>
                        </li>
                    }
                </ul>
            </div>
        </div>

        @* Права колонка (Таблиця аудіту статей) *@
        <div class="lg:col-span-2">
            <div class="border border-black/10 p-6 bg-[#FCFAF5] h-full">
                <h3 class="text-xl font-bold tracking-tight text-black mb-6" style="font-family: 'Georgia';">
                    Recent Publications Audit
                </h3>

                <div class="overflow-x-auto">
                    <table class="w-full text-left" style="border-collapse:collapse;">
                        <thead>
                            <tr class="border-b border-black/30 font-sans">
                                <th class="text-[9px] font-bold uppercase tracking-[0.2em] text-black/40 padding-bottom:12px; pb-3">Title</th>
                                <th class="text-[9px] font-bold uppercase tracking-[0.2em] text-black/40 padding-bottom:12px; pb-3">Author</th>
                                <th class="text-[9px] font-bold uppercase tracking-[0.2em] text-black/40 padding-bottom:12px; pb-3">Status</th>
                                <th class="text-[9px] font-bold uppercase tracking-[0.2em] text-black/40 padding-bottom:12px; pb-3 text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var article in Model)
                            {
                                <tr class="border-b border-black/5 hover:bg-black/[0.01] transition-colors">
                                    <td class="py-4 pr-3">
                                        <a asp-area="" asp-controller="Article" asp-action="Details" asp-route-id="@article.Id"
                                           class="text-base font-bold tracking-tight text-black hover:underline underline-offset-4 decoration-1 transition-all"
                                           style="font-family: 'Georgia';">
                                            @article.Title
                                        </a>
                                    </td>
                                    <td class="py-4 text-[11px] font-sans font-bold uppercase tracking-wider text-black/60">
                                        @article.AuthorName
                                    </td>
                                    <td class="py-4 font-sans">
                                        @if (article.IsPublished)
                                        {
                                            <span class="text-[9px] font-bold uppercase tracking-[0.15em] text-green-800">Live</span>
                                        }
                                        else
                                        {
                                            <span class="text-[9px] font-mono uppercase tracking-wider text-black/40">Draft</span>
                                        }
                                    </td>
                                    <td class="py-4 text-right">
                                        <form method="post"
                                              action="@Url.Action("DeleteArticleFromLog", "Dashboard", new { area = "Admin", id = article.Id })"
                                              onsubmit="return confirm('Redact \'@article.Title.Replace("'", "\\'")\'?')"
                                              style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn-redact">
                                                Redact
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                            @if (!Model.Any())
                            {
                                <tr>
                                    <td colspan="4" class="py-10 text-center font-serif italic text-black/40 text-sm border border-dashed border-black/10 mt-4">
                                        No entries found in system log.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>