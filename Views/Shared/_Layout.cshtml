<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - THE CHRONICLE</title>

    <!-- Інтеграція шрифтів та Tailwind CSS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        /* Глобально задаємо колір фону Eggshell та базовий шрифт для всього body */
        body {
        background-color: #FDFBF7;
        color: #1A1A1A;
        }
    </style>
</head>
<body class="font-sans antialiased min-h-screen flex flex-col justify-between">

    <!-- Строга текстова навігація верхнього рівня -->
    <nav class="w-full max-w-5xl mx-auto px-6 py-6 flex justify-between items-center font-sans text-[11px] uppercase tracking-[0.25em] font-bold border-b border-black/10">
        <div>
            <!-- Посилання на головну замість логотипу -->
            <a asp-area="" asp-controller="Article" asp-action="Index" class="hover:text-black/60 transition-colors">The Chronicle</a>
        </div>

        <div class="flex items-center space-x-6">
            <a asp-area="" asp-controller="Article" asp-action="Index" class="hover:underline pb-0.5">Home</a>

            @if (User.Identity.IsAuthenticated)
            {
                @if (User.IsInRole("Admin"))
                {
                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="hover:underline pb-0.5 text-black tracking-[0.25em]">Admin Panel</a>
                }

                @if (User.IsInRole("Writer"))
                {
                    <a asp-area="" asp-controller="Article" asp-action="MyProfile" class="hover:underline pb-0.5 text-black">My Desk</a>
                }

                <a asp-area="" asp-controller="Article" asp-action="AuthorProfile" class="hover:underline pb-0.5 text-black/60">Profile</a>

                <a asp-area="" asp-controller="Article" asp-action="Logout" class="hover:underline pb-0.5 text-red-800">Sign Out</a>
            }
            else
            {
                <a asp-area="" asp-controller="Article" asp-action="Login" class="hover:underline pb-0.5 text-black">Sign In</a>
            }
        </div>
    </nav>

    <!-- Основний контент сторінки (сюди вбудовуються інші в'юхи) -->
    <main role="main" class="flex-grow">
        @RenderBody()
    </main>

    <!-- Строгий футер -->
    <footer class="w-full max-w-5xl mx-auto px-6 py-8 mt-20 border-t border-black/10 font-sans text-[10px] uppercase tracking-widest text-black/40 flex justify-between items-center">
        <div>
            &copy; @DateTime.Now.Year THE CHRONICLE. All rights reserved.
        </div>
        <div class="space-x-4">
            <span class="font-mono">Status: Corporate Validated</span>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>