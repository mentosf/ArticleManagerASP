<h1>Профіль користувача</h1>
 
<table class="table table-striped">
<thead>
<tr>
<th>Claim Type</th>
<th>Value</th>
</tr>
</thead>
<tbody>
        @foreach (var claim in User.Claims)
        {
<tr>
<td>@claim.Type</td>
<td>@claim.Value</td>
</tr>
        }
</tbody>
</table>
 
<a asp-action="Index" class="btn btn-secondary">На головну</a>
