@model IEnumerable<FinalTask.DTOs.ArticleListItemDto>

@{
    ViewData["Title"] = ViewBag.ProfileType ?? "Profile";
}

<div class="max-w-6xl mx-auto px-6 py-12 bg-[#FDFBF7] text-[#1A1A1A] font-serif min-h-screen">

    <div class="max-w-md mx-auto border border-black/20 bg-[#FCFAF5] p-8 shadow-sm mb-16 relative font-sans">
        <div class="absolute top-3 right-3 text-[8px] tracking-widest uppercase text-black/30">Verified Ledger</div>
        <div class="text-[9px] tracking-[0.3em] uppercase text-black/40 mb-1">Account Identity</div>

        <h2 class="text-3xl font-bold font-['Georgia'] tracking-tight mb-2 text-black">@ViewBag.AuthorName</h2>

        <p class="text-[10px] font-mono text-black/60 uppercase tracking-wider mb-6">
            @if (ViewBag.ProfileType == "Published Works")
            {
                <span>Status: Staff Writer / Columnist</span>
            }
            else
            {
                <span>Status: Platform Contributor</span>
            }
        </p>

        <div class="border-t border-black/10 pt-4 text-[11px] uppercase tracking-widest text-black/50 flex justify-between font-bold">
            <span>Verified Entry</span>
            <span>@Model.Count() Items</span>
        </div>
    </div>

    <h3 class="text-sm uppercase tracking-[0.25em] font-sans font-bold border-b border-black pb-2 mb-8">
        @ViewBag.ProfileType
    </h3>

    @if (!Model.Any())
    {
        <div class="text-center py-16 border border-dashed border-black/10">
            <p class="text-xs font-mono uppercase tracking-widest text-black/40">
                @if (ViewBag.ProfileType == "Published Works")
                {
                    <span>This author has not filed any manuscripts yet.</span>
                }
                else
                {
                    <span>Your reading archive is empty. Mark items to save them here.</span>
                }
            </p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            @foreach (var article in Model)
            {
                <div class="border border-black/10 bg-[#FCFAF5] p-8 flex flex-col justify-between transition-all hover:border-black/30 hover:shadow-sm">
                    <div>
                        <div class="flex justify-between items-center mb-4">
                            <div>
                                @if (ViewBag.ProfileType == "Saved Bookmarks")
                                {
                                    <form asp-action="ToggleFavorite" method="post" class="inline">
                                        <input type="hidden" name="articleId" value="@article.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="text-[10px] font-sans tracking-widest text-red-800 hover:text-red-600 transition-colors uppercase">
                                            ✕ Remove
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-[9px] font-sans tracking-widest text-black/30 uppercase">Manuscript</span>
                                }
                            </div>
                            <div class="font-mono text-[11px] text-black/40">
                                @article.CreatedAt.ToString("dd.MM.yyyy")
                            </div>
                        </div>

                        <h2 class="text-2xl font-bold font-['Georgia'] tracking-tight text-black leading-tight mb-3">
                            <a asp-action="Details" asp-route-id="@article.Id"
                               class="hover:underline hover:decoration-1 hover:underline-offset-4 transition-all">
                                @article.Title
                            </a>
                        </h2>

                        <p class="text-sm text-black/70 font-serif leading-relaxed line-clamp-4">
                            @article.Summary
                        </p>
                    </div>

                    <div class="border-t border-black/10 pt-4 mt-8 flex justify-between items-center text-[11px] font-sans font-bold uppercase tracking-widest">
                        <span class="text-black/50">By <span class="italic font-serif text-black/80">@article.AuthorName</span></span>

                        <a asp-action="Details" asp-route-id="@article.Id"
                           class="text-black hover:text-black/60 underline underline-offset-4 decoration-1 font-medium tracking-[0.15em] transition-colors">
                            Read Article &rarr;
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>