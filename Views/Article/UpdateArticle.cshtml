@model FinalTask.DTOs.ArticleDTO

@{
    ViewData["Title"] = "Edit Manuscript";
}

<div class="max-w-2xl mx-auto px-6 py-12 bg-[#FDFBF7] text-[#1A1A1A] font-sans min-h-screen">
    <div class="border-b border-black pb-4 mb-8">
        <h1 class="text-3xl font-bold font-['Georgia'] uppercase tracking-tight">Edit Manuscript</h1>
        <p class="text-xs text-black/50 uppercase tracking-widest mt-1">Refine your piece with absolute precision</p>
    </div>

    <form asp-action="UpdateArticle" method="post" class="space-y-6">
        <div asp-validation-summary="ModelOnly" class="text-xs font-bold text-red-800 uppercase tracking-wider mb-4"></div>

        <input type="hidden" asp-for="Id" />

        <div class="space-y-1">
            <label asp-for="Title" class="text-[10px] uppercase tracking-[0.25em] font-bold text-black/60">Article Title</label>
            <input asp-for="Title" type="text" autocomplete="off"
                   class="w-full bg-[#FCFAF5] border border-black/20 p-3 font-serif text-lg focus:outline-none focus:border-black transition-colors" />
            <span asp-validation-for="Title" class="text-xs font-mono text-red-800 block mt-1"></span>
        </div>

        <div class="space-y-1">
            <label asp-for="Summary" class="text-[10px] uppercase tracking-[0.25em] font-bold text-black/60">Brief Summary (Abstract)</label>
            <input asp-for="Summary" type="text" autocomplete="off"
                   class="w-full bg-[#FCFAF5] border border-black/20 p-3 text-sm focus:outline-none focus:border-black transition-colors" />
            <span asp-validation-for="Summary" class="text-xs font-mono text-red-800 block mt-1"></span>
        </div>

        <div class="space-y-1">
            <label asp-for="CategoryId" class="text-[10px] uppercase tracking-[0.25em] font-bold text-black/60">Classification (Category)</label>
            <div class="relative border border-black/20 bg-[#FCFAF5]">
                <select asp-for="CategoryId"
                        class="w-full bg-transparent p-3 text-sm font-sans appearance-none focus:outline-none focus:border-black rounded-none cursor-pointer">
                    <option value="" disabled>— Select Category —</option>
                    @if (ViewBag.Categories != null)
                    {
                        foreach (var cat in (IEnumerable<FinalTask.DTOs.CategoryDTO>)ViewBag.Categories)
                        {
                            <option value="@cat.Id">@cat.Name</option>
                        }
                    }
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-4 text-black/40 text-xs">
                    ▼
                </div>
            </div>
            <span asp-validation-for="CategoryId" class="text-xs font-mono text-red-800 block mt-1"></span>
        </div>

        <div class="space-y-1">
            <label asp-for="Content" class="text-[10px] uppercase tracking-[0.25em] font-bold text-black/60">Manuscript Body</label>
            <textarea asp-for="Content" rows="12"
                      class="w-full bg-[#FCFAF5] border border-black/20 p-4 font-serif text-base leading-relaxed focus:outline-none focus:border-black transition-colors resize-y"></textarea>
            <span asp-validation-for="Content" class="text-xs font-mono text-red-800 block mt-1"></span>
        </div>

        <div class="flex justify-end space-x-4 pt-4 border-t border-black/10">
            <a asp-action="MyProfile" class="px-6 py-3 border border-black/30 text-xs uppercase tracking-[0.2em] font-bold hover:bg-black/5 transition-colors text-center">
                Cancel
            </a>
            <button type="submit" class="bg-black text-white px-8 py-3 text-xs uppercase tracking-[0.2em] font-bold hover:bg-black/80 transition-colors">
                Save Changes
            </button>
        </div>
    </form>
</div>