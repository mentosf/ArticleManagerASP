@model FinalTask.DTOs.ArticleDetailsDto

@{
    ViewData["Title"] = Model.Title;
}

<div class="max-w-3xl mx-auto px-6 py-16 bg-[#FDFBF7] text-[#1A1A1A] font-serif min-h-screen">
    <div class="text-center mb-4">
        <span class="text-xs uppercase tracking-[0.25em] font-sans font-bold text-black/60">@Model.CategoryName</span>
    </div>

    <h1 class="text-4xl md:text-5xl font-bold font-['Georgia'] text-center leading-tight mb-6">
        @Model.Title
    </h1>

    <div class="text-center font-sans text-xs uppercase tracking-widest text-black/50 mb-12 pb-6 border-b border-black/10">
        <p class="text-xs font-sans text-black/50 uppercase tracking-widest">
            Published by
            <a asp-controller="Article"
               asp-action="AuthorProfile"
               asp-route-authorId="@Model.AuthorId"
               class="text-black font-bold hover:underline hover:underline-offset-4 decoration-1 transition-colors">
                @Model.AuthorName
            </a>
            on @Model.CreatedAt.ToString("MMMM dd, yyyy")
        </p>
    </div>

    @if (!string.IsNullOrEmpty(Model.Summary))
    {
        <p class="text-lg italic text-black/80 leading-relaxed mb-10 pl-4 border-l-2 border-black">
            @Model.Summary
        </p>
    }

    <article class="text-base md:text-lg leading-loose text-black/90 space-y-6 font-['Georgia'] antialiased whitespace-pre-line">
        @Model.Content
    </article>

    <section class="mt-20 pt-10 border-t-2 border-black">
        <h3 class="text-xl uppercase tracking-wider font-sans font-bold mb-8">Discussion (@Model.Comments.Count)</h3>

        @if (User.Identity.IsAuthenticated)
        {
            <form asp-action="AddComment" method="post" class="mb-12">
                <input type="hidden" name="articleId" value="@Model.Id" />
                <div class="border border-black/20 p-2 bg-white">
                    <textarea name="text" rows="4" required
                              class="w-full p-2 bg-transparent font-sans text-sm focus:outline-none resize-none"
                              placeholder="Write your response..."></textarea>
                </div>
                <div class="flex justify-end mt-3">
                    <button type="submit" class="bg-black text-white px-6 py-2.5 text-xs uppercase tracking-[0.2em] font-sans font-bold transition-colors hover:bg-black/80">
                        Publish Comment
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="border border-dashed border-black/20 p-6 text-center mb-10 font-sans text-sm text-black/60">
                <a asp-action="Login" class="underline font-bold text-black">Sign in</a> to join the conversation.
            </div>
        }

        <div class="space-y-6">
            @foreach (var comment in Model.Comments)
            {
                <div class="border-b border-black/5 pb-6">
                    <div class="flex justify-between items-center font-sans text-xs text-black/50 mb-2">
                        <span class="font-bold text-black">@comment.Username</span>
                        <span>@comment.CreatedAt.ToString("dd MMM, yyyy HH:mm")</span>
                    </div>
                    <p class="font-sans text-sm text-black/85 leading-relaxed">
                        @comment.Text
                    </p>
                </div>
            }
        </div>
    </section>
</div>